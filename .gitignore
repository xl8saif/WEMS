# Private business data - NEVER upload these
# (root-anchored so they don't match same-named source folders like templates/invoices/)
/database/*.db
/database/waraq.db
/invoices/
/exports/
/backups/
/uploads/
# NOTE: static/images/ is NOT ignored — it holds brand assets (logos, portrait,
# theme ornament) that ARE tracked and must ship with the repo. Only the private
# data folders above are excluded.

# Python cache
__pycache__/
*.pyc
*.pyo
.env

# IDE files
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store
# User-uploaded CVs (private documents)
uploads/
